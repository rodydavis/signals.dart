{
  "name": "signals-dart",
  "displayName": "Signals Snippets (Dart/Flutter)",
  "description": "VS Code Extension for Signals (Dart/Flutter)",
  "version": "1.0.0",
  "publisher": "rodydavis",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "flutter",
    "signals",
    "flutter signals",
    "signals flutter",
    "signals dart",
    "dart signals",
    "dart",
    "flutter signals snippets",
    "flutter signals extension",
    "signals extension",
    "signals snippets"
  ],
  "activationEvents": [
    "onLanguage:dart",
    "onLanguage:yaml",
    "onView:signals-explorer",
    "workspaceContains:pubspec.yaml",
    "onCommand:signals-dart.installSkills",
    "onCommand:signals-dart.showDocumentation"
  ],
  "main": "./dist/web/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "dart",
        "path": "./snippets/signals.json"
      }
    ],
    "commands": [
      {
        "command": "signals-dart.installSkills",
        "title": "Signals: Install AI Developer Skills to Workspace",
        "category": "Signals"
      },
      {
        "command": "signals-dart.showDocumentation",
        "title": "Signals: Show Documentation Explorer",
        "category": "Signals"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "signals-sidebar",
          "title": "Signals",
          "icon": "assets/icon.png"
        }
      ]
    },
    "views": {
      "signals-sidebar": [
        {
          "type": "webview",
          "id": "signals-explorer",
          "name": "Signals Explorer"
        }
      ]
    }
  },
  "bugs": {
    "url": "https://github.com/rodydavis/signals.dart/issues",
    "email": "rody.davis.jr@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rodydavis/signals.dart"
  },
  "author": {
    "name": "Rody Davis"
  },
  "license": "SEE LICENSE",
  "browser": "./dist/web/extension.js",
  "contributors": [
    {
      "name": "Deepraj Baidya",
      "url": "https://github.com/deepraj02"
    },
    {
      "name": "Rody Davis",
      "url": "https://github.com/rodydavis"
    }
  ],
  "homepage": " https://dartsignals.dev/",
  "icon": "assets/icon.png",
  "scripts": {
    "copy-skills": "node scripts/copy-skills.js",
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run copy-skills && npm run package-web",
    "build": "npm run copy-skills && npm run compile-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^9.0.0",
    "@types/vscode": "^1.63.0",
    "@types/webpack-env": "^1.16.3",
    "@typescript-eslint/eslint-plugin": "^5.9.1",
    "@typescript-eslint/parser": "^5.9.1",
    "@vscode/test-web": "^0.0.15",
    "@vscode/vsce": "^2.23.0",
    "assert": "^2.0.0",
    "eslint": "^8.6.0",
    "mocha": "^9.1.3",
    "process": "^0.11.10",
    "ts-loader": "^9.2.6",
    "typescript": "^4.5.4",
    "webpack": "^5.66.0",
    "webpack-cli": "^4.9.1"
  }
}
